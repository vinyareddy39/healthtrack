# ========================================================
# RecoverTrack Monorepo Environment Configuration
# ========================================================

# --- SERVER CONFIGURATION ---
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/recovertrack

# Security & Encryption (AES-256-GCM 32-byte hex key = 64 hex chars)
# IMPORTANT: In production, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
EMAIL_HASH_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=super_secure_jwt_secret_change_in_production_1234567890
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=super_secure_refresh_token_secret_1234567890
REFRESH_TOKEN_EXPIRES_IN=7d

# Microservice communication shared secret
ML_SERVICE_URL=http://localhost:8000
ML_SHARED_SECRET=recovertrack_internal_ml_secret_key_884930

# Web Push Notification VAPID Keys
# Generate new pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
VAPID_PRIVATE_KEY=AVP_YOUR_PRIVATE_VAPID_KEY_HERE
VAPID_SUBJECT=mailto:admin@recovertrack.local

# Reminders & Messaging (Free tiers only)
# Telegram Bot Token (free from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=RecoverTrackBot

# Email SMTP (Gmail App Password or Brevo free SMTP - capped at 100/day in code)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RecoverTrack <no-reply@recovertrack.local>

# --- ML SERVICE CONFIGURATION ---
ML_PORT=8000
ML_ENV=development
SHARED_SECRET=recovertrack_internal_ml_secret_key_884930
OCR_MODEL_HANDWRITTEN=microsoft/trocr-base-handwritten
OCR_MODEL_PRINTED=microsoft/trocr-base-printed
USE_GPU=false
MAX_CONCURRENT_OCR=1

# --- CLIENT CONFIGURATION ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_VAPID_PUBLIC_KEY=BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBkr3qBUYIHBQFLXYp5Nksh8U
